{
  "name": "private-video-downloader",
  "version": "1.0.0",
  "description": "A standalone desktop video downloader powered by Electron, Angular, and yt-dlp",
  "main": "electron/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Developer-Geekay/yt-downloader.git"
  },
  "scripts": {
    "setup": "node scripts/bundle-ffmpeg.js && node scripts/bundle-ytdlp.js && node scripts/bundle-node.js",
    "setup:ffmpeg": "node scripts/bundle-ffmpeg.js",
    "setup:ytdlp": "node scripts/bundle-ytdlp.js",
    "setup:node": "node scripts/bundle-node.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "cd frontend/yt-interface && npx ng serve --port 4200",
    "dev:electron:live": "cross-env ELECTRON_DEV=true electron .",
    "dev:electron": "npm run build:frontend && electron .",
    "build:frontend": "cd frontend/yt-interface && npm run build -- --configuration production",
    "start": "electron .",
    "dist": "npm run build:frontend && electron-builder",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:linux": "npm run build:frontend && electron-builder --linux"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.private-video-downloader.app",
    "productName": "Video Downloader",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Developer-Geekay",
        "repo": "yt-downloader"
      }
    ],
    "files": [
      "electron/**/*",
      "frontend/yt-interface/dist/**/*",
      "backend-node/**/*",
      "resources/ffmpeg/**/*",
      "resources/yt-dlp/**/*",
      "resources/node/**/*",
      "!backend-node/**/__pycache__/**"
    ],
    "asarUnpack": [
      "backend-node/**/*",
      "resources/ffmpeg/**/*",
      "resources/yt-dlp/**/*",
      "resources/node/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": {
        "teamId": "${APPLE_TEAM_ID}"
      }
    },
    "linux": {
      "target": ["AppImage", "deb", "portable"],
      "icon": "assets/icon.png"
    }
  }
}
